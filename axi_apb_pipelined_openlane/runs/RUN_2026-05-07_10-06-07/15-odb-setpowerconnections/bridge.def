    - wdata[8] ( PIN wdata[8] ) + USE SIGNAL ;
    - wdata[9] ( PIN wdata[9] ) + USE SIGNAL ;
    - wlast ( PIN wlast ) ( _250_ A_N ) ( _249_ A_N ) + USE SIGNAL ;
    - wready ( PIN wready ) ( _262_ A1 ) ( _250_ B ) ( _224_ A2 ) ( _219_ A2_N ) ( _211_ A2 ) ( _202_ A2 )
      ( _201_ A2 ) ( _199_ C ) ( _198_ B ) ( _146_ Y ) + USE SIGNAL ;
    - wvalid ( PIN wvalid ) ( _286_ D ) + USE SIGNAL ;
    - wvalid_pipe ( _286_ Q ) ( _261_ A1 ) ( _132_ A ) + USE SIGNAL ;
END NETS
END DESIGN
